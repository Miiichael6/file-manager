---
// Lišta novinky a plovoucí navigace (pilulka). Na podstránkách vedou kotvy na úvod,
// přepínač jazyka na stejnou stránku v druhém jazyce.
import { Picture } from "astro:assets";
import appIcon from "../../../app-icon.png";
import { texts, type Lang } from "../i18n/texts";
import { icon } from "../lib/icons";
import { links, storeLink, pageHref, type PagePath } from "../lib/links";

interface Props { lang: Lang; path: PagePath }
const { lang, path } = Astro.props;
const t = texts[lang];
const home = pageHref(lang);
// Na úvodu jen kotva (bez znovunačtení), jinde adresa úvodu + kotva.
const anchor = (id: string) => (path === "" ? `#${id}` : `${home}#${id}`);
const github = `<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>`;
---
<a class="announce" href={storeLink(lang)}>
  <span class="announce-tag">{t.announceTag}</span>
  <span>{t.announce}</span>
  <Fragment set:html={icon("ArrowRight", 14)} />
</a>

<header class="nav-wrap">
  <nav class="nav" aria-label="Dirwise">
    <a class="nav-brand" href={home} aria-label={t.nav.home}>
      <Picture src={appIcon} width={22} height={22} densities={[2, 3]} formats={["avif", "webp"]} alt="" loading="eager" />
      <span>Dirwise</span>
    </a>
    <div class="nav-links">
      <a href={anchor("features")}>{t.nav.features}</a>
      <a href={anchor("download")}>{t.nav.download}</a>
      <a href={anchor("faq")}>{t.nav.faq}</a>
      <a href={pageHref(lang, "ideas/")} aria-current={path === "ideas/" ? "page" : undefined}>{t.nav.ideas}</a>
    </div>
    <div class="nav-end">
      <a href={links.repo} class="nav-icon" aria-label="GitHub" set:html={github} />
      <div class="lang" role="group" aria-label={t.langSwitch}>
        <a href={pageHref("en", path)} hreflang="en" lang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a>
        <a href={pageHref("cs", path)} hreflang="cs" lang="cs" aria-current={lang === "cs" ? "page" : undefined}>CS</a>
      </div>
    </div>
  </nav>
</header>
